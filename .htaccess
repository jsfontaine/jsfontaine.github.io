# ------------------------------------------------------------------
# jean-sebastienfontaine.com
#
# This file is named .htaccess (with the dot) and lives in public_html.
# Lines starting with # are notes and are ignored by the server.
# ------------------------------------------------------------------


# --- 1. Make your edits show up straight away -----------------------
#
# Browsers keep copies of files so they load faster next time. Without
# a rule, someone who visited before can keep seeing an old copy for
# days after you change something.
#
# "no-cache" does NOT mean "don't store it". It means "ask the server
# whether it changed before reusing it". If nothing changed the server
# says so in a few bytes and the browser reuses what it has — so the
# site stays fast, but an edit is visible immediately.

<IfModule mod_headers.c>

  # Pages, styling, papers and data: always check for a newer version.
  # PDFs are in here because working-paper drafts get replaced, and a
  # visitor holding yesterday's draft is exactly the problem.
  <FilesMatch "\.(html|css|pdf|csv|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Typefaces never change. Let browsers keep them for a year.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Photographs: keep for a week. If you swap one, give it a new
  # filename and the change is instant.
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

</IfModule>


# --- 2. Don't show visitors a list of your files --------------------
#
# Without this, anyone visiting www.jean-sebastienfontaine.com/papers/
# gets a browsable index of everything in that folder. Your PDFs are
# meant to be public, but an open file listing is untidy.

Options -Indexes


# --- 3. Force the secure version of the site ------------------------
#
# LEAVE THIS COMMENTED OUT until the padlock shows in your browser.
# With a broken certificate this makes the site unreachable rather
# than merely insecure. To switch it on, delete the # at the start of
# the four lines below (not this explanatory block).
#
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>